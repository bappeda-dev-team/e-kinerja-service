# ================================
# Database (PostgreSQL)
# ================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_db_password
DB_NAME=db_internal
DB_SSLMODE=disable
# Untuk koneksi cloud (Zeabur, Supabase, dll) gunakan: require

# ================================
# Aplikasi
# ================================
APP_PORT=8080

# ================================
# JWT
# ================================
JWT_SECRET=your_jwt_secret_key

# ================================
# S3 / Object Storage
# ================================
# Untuk AWS S3 asli: isi S3_REGION, kosongkan S3_ENDPOINT
# Untuk S3-compatible (MinIO, Cloudflare R2, dll): isi S3_ENDPOINT

S3_BUCKET=your-bucket-name
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_ENDPOINT=
# Contoh MinIO: S3_ENDPOINT=http://localhost:9000
# Contoh Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
